// Общий модуль ЕдинаяБазаGB (расширение GadgetBarIntegration)
// Префикс расширения: GadgetBar_
// Назначение: подписки на события 1С для выгрузки в Единую базу (gbsale.ru).
// Логика:
//   - Номенклатура: синхронно при записи, через очередь (один товар за раз).
//   - Цены: пачкой строк документа «Установка цен» в очередь (/api/1c/prices/sync).
//     1С не ждёт ответа, отправку выполняет фоновое/регламентное задание.
//   - Остатки: подписка на запись регистра накопления «Запасы» (/api/1c/stocks/sync).
//     Отправляется АКТУАЛЬНЫЙ остаток (срез) по каждой затронутой паре товар+склад,
//     а не количество из документа. Синхронно, 1С ждёт ответа (таймаут 3 сек).
//   - Склады: подписка на запись справочника «Структурные единицы» (/api/1c/stores/sync),
//     плюс ручная полная выгрузка ВыгрузитьВсеСклады().

#Область Настройки

// URL Единой базы (без закрывающего слеша)
Функция Хост()
    Возврат "gbsale.ru";
КонецФункции

Функция БазовыйURL()
    Возврат "https://gbsale.ru";
КонецФункции

// API-ключ для /api/1c/* (см. IMPORT_1C_API_KEY в .env сервера)
// ВАЖНО: реальный ключ не храним в репозитории. Возьмите значение из .env.secrets
// (IMPORT_1C_API_KEY) и впишите сюда при установке расширения в базу 1С.
Функция APIКлюч()
    Возврат "INSERT_IMPORT_1C_API_KEY_HERE";
КонецФункции

#КонецОбласти


#Область ПодпискиНаСобытия

// Подписка: ПриЗаписи номенклатуры
Процедура ПриЗаписиНоменклатуры(Источник, Отказ) Экспорт
    Лог("вызвана подписка ПриЗаписиНоменклатуры");
    Если Отказ Тогда
        Возврат;
    КонецЕсли;

    Попытка
        Данные = Новый Структура;
        Данные.Вставить("external_id", Строка(Источник.Ссылка.УникальныйИдентификатор()));
        Данные.Вставить("name",        Строка(Источник.Наименование));
        Данные.Вставить("sku",         Строка(Источник.Артикул));
        Данные.Вставить("is_active",   НЕ Источник.ПометкаУдаления);

        // Родительская категория (если есть)
        Если ЗначениеЗаполнено(Источник.Родитель) Тогда
            Данные.Вставить("category_external_id", Строка(Источник.Родитель.УникальныйИдентификатор()));
        КонецЕсли;

        ДобавитьВОчередь("/api/1c/products", Данные);
    Исключение
        ЗаписатьОшибку("ПриЗаписиНоменклатуры", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// Подписка: ОбработкаПроведения документа «Установка цен номенклатуры»
Процедура ПриПроведенииУстановкиЦен(Источник, Отказ, РежимПроведения) Экспорт
    Лог("вызвана подписка ПриПроведенииУстановкиЦен");
    ЗаписатьИнфо("ПриПроведенииУстановкиЦен", "Старт обработки документа установки цен");
    Если Отказ Тогда
        Возврат;
    КонецЕсли;

    Попытка
        МассивЦен = Новый Массив;
        ТабЧасть = ТабличнаяЧастьТовары(Источник);

        Если ТабЧасть = Неопределено Тогда
            ЗаписатьОшибку("ПриПроведенииУстановкиЦен", "Не найдена табличная часть товаров в документе.");
            Возврат;
        КонецЕсли;

        ЗаписатьИнфо("ПриПроведенииУстановкиЦен", "Найдено строк в документе: " + ТабЧасть.Количество());
        Для Каждого Строка Из ТабЧасть Цикл

            Номенклатура = Строка.Номенклатура;
            Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
                Продолжить;
            КонецЕсли;

            // ВидЦен сначала ищем в строке, если нет — в шапке документа.
            ВидЦен = Неопределено;
            Попытка
                ВидЦен = Строка.ВидЦен;
            Исключение
                Попытка
                    ВидЦен = Источник.ВидЦен;
                Исключение
                    ВидЦен = Неопределено;
                КонецПопытки;
            КонецПопытки;

            Цена = 0;
            Попытка
                Цена = Строка.Цена;
            Исключение
                Попытка
                    Цена = Строка.ЦенаНовая;
                Исключение
                    Цена = 0;
                КонецПопытки;
            КонецПопытки;

            Если Цена = 0 Тогда
                Продолжить;
            КонецЕсли;

            Данные = Новый Структура;
            Данные.Вставить("offer_external_id", Строка(Номенклатура.УникальныйИдентификатор()));
            Данные.Вставить("name",              Строка(Номенклатура.Наименование));
            Данные.Вставить("price_type",        Строка(ВидЦен));
            Данные.Вставить("price",             Цена);
            Данные.Вставить("currency",          "RUB");

            МассивЦен.Добавить(Данные);
        КонецЦикла;

        Если МассивЦен.Количество() > 0 Тогда
            ЗаписатьИнфо("ПриПроведенииУстановкиЦен", "Добавляем в очередь " + МассивЦен.Количество() + " цен");
            ДобавитьВОчередь("/api/1c/prices/sync", Новый Структура("items", МассивЦен));
        Иначе
            ЗаписатьИнфо("ПриПроведенииУстановкиЦен", "Массив цен пустой");
        КонецЕсли;
    Исключение
        ЗаписатьОшибку("ПриПроведенииУстановкиЦен", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// Подписка: ПриЗаписи набора записей регистра накопления «Запасы».
// Вместо документов движения: считаем АКТУАЛЬНЫЙ остаток (срез) по каждой
// затронутой паре товар+склад и отправляем его на сайт.
// Подписка вызывается ДО записи набора, поэтому итог = текущие остатки в регистре
// плюс дельта нового набора движений. При перепроведении это тоже корректно:
// старые движения документа к этому моменту уже выключены из итогов.
// Ограничение: отмена проведения (пустой набор с замещением) движений не содержит,
// поэтому после отмены проведения остаток обновится при следующем движении
// или полной выгрузке.
Процедура ПриЗаписиЗапасов(Источник, Отказ, Замещение) Экспорт
    Лог("вызвана подписка ПриЗаписиЗапасов, движений в наборе: " + Источник.Количество());
    Если Отказ Тогда
        Возврат;
    КонецЕсли;

    Попытка
        // Дельты по парам Номенклатура+Склад из нового набора движений.
        Дельты = Новый Соответствие;
        СписокНоменклатуры = Новый Массив;

        Для Каждого Движение Из Источник Цикл
            Если НЕ ЗначениеЗаполнено(Движение.Номенклатура) Тогда
                Продолжить;
            КонецЕсли;

            Ключ = КлючПарыОстатка(Движение.Номенклатура, Движение.СтруктурнаяЕдиница);

            Инфо = Дельты[Ключ];
            Если Инфо = Неопределено Тогда
                Инфо = Новый Структура("Номенклатура, Склад, Дельта",
                    Движение.Номенклатура, Движение.СтруктурнаяЕдиница, 0);
                Дельты[Ключ] = Инфо;
                СписокНоменклатуры.Добавить(Движение.Номенклатура);
            КонецЕсли;

            Знак = ?(Движение.ВидДвижения = ВидДвиженияНакопления.Приход, 1, -1);
            Инфо.Дельта = Инфо.Дельта + Знак * Движение.Количество;
        КонецЦикла;

        Если Дельты.Количество() = 0 Тогда
            Лог("ПриЗаписиЗапасов, нет движений по номенклатуре — пропуск");
            Возврат;
        КонецЕсли;

        // Текущие остатки по всем затронутым товарам одним запросом.
        Запрос = Новый Запрос;
        Запрос.Текст =
            "ВЫБРАТЬ
            |   Остатки.Номенклатура КАК Номенклатура,
            |   Остатки.СтруктурнаяЕдиница КАК Склад,
            |   СУММА(Остатки.КоличествоОстаток) КАК Остаток
            |ИЗ
            |   РегистрНакопления.Запасы.Остатки(, Номенклатура В (&Список)) КАК Остатки
            |СГРУППИРОВАТЬ ПО
            |   Остатки.Номенклатура,
            |   Остатки.СтруктурнаяЕдиница";
        Запрос.УстановитьПараметр("Список", СписокНоменклатуры);

        ОстаткиПоКлючам = Новый Соответствие;
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            ОстаткиПоКлючам[КлючПарыОстатка(Выборка.Номенклатура, Выборка.Склад)] = Выборка.Остаток;
        КонецЦикла;

        // Итоговый остаток = текущий итог + дельта набора. Нули тоже шлём —
        // сайт должен обнулить остаток, если товар закончился.
        МассивОстатков = Новый Массив;
        Для Каждого Эл Из Дельты Цикл
            Инфо = Эл.Значение;
            Текущий = ОстаткиПоКлючам[Эл.Ключ];
            Если Текущий = Неопределено Тогда
                Текущий = 0;
            КонецЕсли;

            НовыйОстаток = Текущий + Инфо.Дельта;
            Если НовыйОстаток < 0 Тогда
                НовыйОстаток = 0;
            КонецЕсли;

            Данные = Новый Структура;
            Данные.Вставить("offer_external_id", Строка(Инфо.Номенклатура.УникальныйИдентификатор()));
            Данные.Вставить("name",              Строка(Инфо.Номенклатура.Наименование));
            Данные.Вставить("quantity",          НовыйОстаток);
            Если ЗначениеЗаполнено(Инфо.Склад) Тогда
                Данные.Вставить("store_external_id", Строка(Инфо.Склад.УникальныйИдентификатор()));
                Данные.Вставить("store_name",        Строка(Инфо.Склад.Наименование));
            КонецЕсли;

            МассивОстатков.Добавить(Данные);
        КонецЦикла;

        Лог("остатки, пар товар+склад к отправке: " + МассивОстатков.Количество());

        ТелоЗапроса = СтруктураВJSON(Новый Структура("items", МассивОстатков));
        Попытка
            Ответ = HTTPВызов("POST", "/api/1c/stocks/sync", ТелоЗапроса);
            Лог("отправлено /api/1c/stocks/sync -> " + Ответ.КодСостояния);
            Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
                ЗаписатьОшибку("ПриЗаписиЗапасов", "HTTP " + Ответ.КодСостояния + ": " + Ответ.ПолучитьТелоКакСтроку());
                ОстаткиВОчередь(ТелоЗапроса);
            КонецЕсли;
        Исключение
            Лог("исключение отправки остатков, кладём в очередь: " + ОписаниеОшибки());
            ЗаписатьОшибку("ПриЗаписиЗапасов", ОписаниеОшибки());
            ОстаткиВОчередь(ТелоЗапроса);
        КонецПопытки;
    Исключение
        Лог("исключение ПриЗаписиЗапасов: " + ОписаниеОшибки());
        ЗаписатьОшибку("ПриЗаписиЗапасов", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// Подстраховка: кладёт пачку остатков в регистр очереди,
// откуда её добьёт регламентное задание (ОбработатьОчередь).
Процедура ОстаткиВОчередь(ТелоЗапроса)
    Попытка
        Запись = РегистрыСведений.GadgetBar_ОчередьОбмена.СоздатьМенеджерЗаписи();
        Запись.Endpoint       = "/api/1c/stocks/sync";
        Запись.Идентификатор  = Новый УникальныйИдентификатор;
        Запись.Payload        = ТелоЗапроса;
        Запись.ДатаСобытия    = ТекущаяДата();
        Запись.Обработано     = Ложь;
        Запись.Попыток        = 0;
        Запись.Записать();
        Лог("остатки записаны в очередь на досылку");
    Исключение
        ЗаписатьОшибку("ОстаткиВОчередь", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// Ключ пары Номенклатура+Склад для сопоставлений.
Функция КлючПарыОстатка(Номенклатура, Склад)
    Возврат Строка(Номенклатура.УникальныйИдентификатор()) + "|"
        + ?(ЗначениеЗаполнено(Склад), Строка(Склад.УникальныйИдентификатор()), "");
КонецФункции

// Подписка: ПриЗаписи справочника «Структурные единицы» (склады/магазины).
// Склады меняются редко, но город/название нужны боту для ответов по наличию.
Процедура ПриЗаписиСтруктурнойЕдиницы(Источник, Отказ) Экспорт
    Лог("вызвана подписка ПриЗаписиСтруктурнойЕдиницы");
    Если Отказ Тогда
        Возврат;
    КонецЕсли;

    Попытка
        ОтправитьСкладыНаСайт(СкладВСтруктуру(Источник));
    Исключение
        Лог("исключение ПриЗаписиСтруктурнойЕдиницы: " + ОписаниеОшибки());
        ЗаписатьОшибку("ПриЗаписиСтруктурнойЕдиницы", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// Ручная полная выгрузка всех складов на сайт (первичная заливка).
// Вызвать один раз: ЕдинаяБазаGB.ВыгрузитьВсеСклады();
Процедура ВыгрузитьВсеСклады() Экспорт
    Лог("ВыгрузитьВсеСклады, старт");

    Попытка
        МассивСкладов = Новый Массив;

        Запрос = Новый Запрос;
        Запрос.Текст =
            "ВЫБРАТЬ
            |   СтруктурныеЕдиницы.Ссылка КАК Ссылка
            |ИЗ
            |   Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы";

        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            МассивСкладов.Добавить(СкладВСтруктуру(Выборка.Ссылка));
        КонецЦикла;

        Лог("складов к выгрузке: " + МассивСкладов.Количество());

        Если МассивСкладов.Количество() > 0 Тогда
            ОтправитьСкладыНаСайт(МассивСкладов);
        КонецЕсли;
    Исключение
        Лог("исключение ВыгрузитьВсеСклады: " + ОписаниеОшибки());
        ЗаписатьОшибку("ВыгрузитьВсеСклады", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// Структура склада для отправки на сайт.
// Принимает и ссылку, и объект справочника: УникальныйИдентификатор()
// есть только у ссылки, поэтому работаем через неё.
Функция СкладВСтруктуру(Склад)
    Ссылка = Склад;
    Если ТипЗнч(Склад) <> Тип("СправочникСсылка.СтруктурныеЕдиницы") Тогда
        Ссылка = Склад.Ссылка;
    КонецЕсли;

    Данные = Новый Структура;
    Данные.Вставить("external_id", Строка(Ссылка.УникальныйИдентификатор()));
    Данные.Вставить("name",        Строка(Ссылка.Наименование));
    Данные.Вставить("is_active",   НЕ Ссылка.ПометкаУдаления);

    // Город: если у склада есть реквизит «Город» — передаём.
    // Если реквизита нет, город заполняется вручную в админке сайта
    // (синхронизация его не затирает).
    Попытка
        Если ЗначениеЗаполнено(Ссылка.Город) Тогда
            Данные.Вставить("city", Строка(Ссылка.Город));
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат Данные;
КонецФункции

// Отправка складов пачкой в /api/1c/stores/sync.
Процедура ОтправитьСкладыНаСайт(МассивСкладов)
    Если ТипЗнч(МассивСкладов) <> Тип("Массив") Тогда
        Один = Новый Массив;
        Один.Добавить(МассивСкладов);
        МассивСкладов = Один;
    КонецЕсли;

    Ответ = HTTPВызов("POST", "/api/1c/stores/sync", СтруктураВJSON(Новый Структура("items", МассивСкладов)));
    Лог("отправлено /api/1c/stores/sync -> " + Ответ.КодСостояния
        + ", складов: " + МассивСкладов.Количество());
    Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
        ЗаписатьОшибку("ОтправитьСкладыНаСайт", "HTTP " + Ответ.КодСостояния + ": " + Ответ.ПолучитьТелоКакСтроку());
    КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область Очередь

// Регистр сведений «GadgetBar_ОчередьОбмена» (измерения/ресурсы см. в инструкции по установке):
//   Измерения:  Endpoint (Строка 100), Идентификатор (УникальныйИдентификатор)
//   Ресурсы:    Payload (Строка неограниченной длины), ДатаСобытия (Дата),
//               Обработано (Булево), ДатаОбработки (Дата), Ошибка (Строка 1000), Попыток (Число 2)
Процедура ДобавитьВОчередь(Endpoint, Данные) Экспорт

    Лог("ДобавитьВОчередь " + Endpoint);
    ЗаписатьИнфо("ДобавитьВОчередь", "Endpoint: " + Endpoint);

    Идентификатор = Новый УникальныйИдентификатор;

    Запись = РегистрыСведений.GadgetBar_ОчередьОбмена.СоздатьМенеджерЗаписи();
    Запись.Endpoint       = Endpoint;
    Запись.Идентификатор  = Идентификатор;
    Запись.Payload        = СтруктураВJSON(Данные);
    Запись.ДатаСобытия    = ТекущаяДата();
    Запись.Обработано     = Ложь;
    Запись.Попыток        = 0;
    Запись.Записать();

    // В файловой базе фоновые задания не запускаются автоматически,
    // поэтому отправляем свежую запись сразу в том же сеансе.
    // Это блокирует 1С на время одного HTTP-вызова, но гарантирует отправку.
    Попытка
        Ответ = HTTPВызов("POST", Endpoint, Запись.Payload);
        Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
            Запись.Обработано    = Истина;
            Запись.ДатаОбработки = ТекущаяДата();
            Запись.Ошибка        = "";
            Лог("отправлено " + Endpoint + " -> " + Ответ.КодСостояния);
        Иначе
            Запись.Попыток = 1;
            Запись.Ошибка  = "HTTP " + Ответ.КодСостояния + ": " + Ответ.ПолучитьТелоКакСтроку();
            Лог("ошибка отправки " + Endpoint + " -> " + Ответ.КодСостояния);
        КонецЕсли;
    Исключение
        Запись.Попыток = 1;
        Запись.Ошибка  = ОписаниеОшибки();
        Лог("исключение при отправке " + Endpoint + ": " + ОписаниеОшибки());
    КонецПопытки;

    Запись.Записать(Истина);

КонецПроцедуры

// Выполняется регламентным заданием «GadgetBar_ВыгрузкаВЕдинуюБазу».
// Подписки на события не запускают эту процедуру напрямую — чтобы не тормозить проведение/запись в 1С.
Процедура ОбработатьОчередь() Экспорт    Лог("ОбработатьОчередь старт");

    // Раз в сутки (первый запуск после 6:00) чистим журнал обмена старше 7 дней.
    Если Час(ТекущаяДата()) = 6 Тогда
        ОчиститьЖурнал();
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 100
        |   Очередь.Endpoint КАК Endpoint,
        |   Очередь.Идентификатор КАК Идентификатор,
        |   Очередь.Payload КАК Payload,
        |   Очередь.Попыток КАК Попыток
        |ИЗ
        |   РегистрСведений.GadgetBar_ОчередьОбмена КАК Очередь
        |ГДЕ
        |   Очередь.Обработано = ЛОЖЬ
        |   И Очередь.Попыток < 5
        |УПОРЯДОЧИТЬ ПО
        |   Очередь.ДатаСобытия";

    Результат = Запрос.Выполнить();
    Если Результат.Пустой() Тогда
        Возврат;
    КонецЕсли;

    Выборка = Результат.Выбрать();
    ЗаписатьИнфо("ОбработатьОчередь", "Записей к отправке: " + Выборка.Количество());
    Пока Выборка.Следующий() Цикл
        ОтправитьЗапись(Выборка);
    КонецЦикла;

КонецПроцедуры

// Полностью очищает регистр очереди обмена.
// Нужна для удаления битых/устаревших записей (например, с пустым Payload),
// которые регламентное задание безуспешно ретраит. Вызвать вручную один раз:
//   ЕдинаяБазаGB.ОчиститьОчередь();
Процедура ОчиститьОчередь() Экспорт

    Набор = РегистрыСведений.GadgetBar_ОчередьОбмена.СоздатьНаборЗаписей();
    Набор.Записать(Истина); // запись пустого набора удаляет все записи регистра

    Лог("очередь обмена очищена");
    ЗаписатьИнфо("ОчиститьОчередь", "Регистр очереди обмена полностью очищен");

КонецПроцедуры

Процедура ОтправитьЗапись(Выборка)

    Лог("ОтправитьЗапись " + Выборка.Endpoint);

    Запись = РегистрыСведений.GadgetBar_ОчередьОбмена.СоздатьМенеджерЗаписи();
    Запись.Endpoint      = Выборка.Endpoint;
    Запись.Идентификатор = Выборка.Идентификатор;

    Попытка
        Ответ = HTTPВызов("POST", Выборка.Endpoint, Выборка.Payload);

        Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
            Запись.Обработано     = Истина;
            Запись.ДатаОбработки  = ТекущаяДата();
            Запись.Ошибка         = "";
        Иначе
            Запись.Попыток = Выборка.Попыток + 1;
            Запись.Ошибка  = "HTTP " + Ответ.КодСостояния + ": " + Ответ.ПолучитьТелоКакСтроку();
        КонецЕсли;
    Исключение
        Запись.Попыток = Выборка.Попыток + 1;
        Запись.Ошибка  = ОписаниеОшибки();
    КонецПопытки;

    Запись.Записать(Истина);

КонецПроцедуры

#КонецОбласти


#Область HTTP

Функция HTTPВызов(Метод, Endpoint, ТелоJSON)

    HTTP = Новый HTTPСоединение(
        Хост(),
        , // порт
        , // пользователь
        , // пароль
        , // прокси
        3, // таймаут в секундах (короткий, чтобы не блокировать проведение чека на кассе)
        Новый ЗащищенноеСоединениеOpenSSL()
    );

    Запрос = Новый HTTPЗапрос(Endpoint);
    Запрос.Заголовки.Вставить("Content-Type",  "application/json");
    Запрос.Заголовки.Вставить("Accept",        "application/json");
    Запрос.Заголовки.Вставить("X-1C-API-Key", APIКлюч());
    Запрос.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8);

    Если ВРег(Метод) = "POST" Тогда
        Возврат HTTP.ОтправитьДляОбработки(Запрос);
    ИначеЕсли ВРег(Метод) = "PUT" Тогда
        Возврат HTTP.Записать(Запрос);
    Иначе
        Возврат HTTP.Получить(Запрос);
    КонецЕсли;

КонецФункции

#КонецОбласти


#Область Служебные

// Определяет табличную часть с товарами в документе.
// В разных документах УНФ она может называться «Запасы» или «Товары».
Функция ТабличнаяЧастьТовары(Источник)

    Если Источник.Метаданные().ТабличныеЧасти.Найти("Запасы") <> Неопределено Тогда
        Возврат Источник.Запасы;
    КонецЕсли;

    Если Источник.Метаданные().ТабличныеЧасти.Найти("Товары") <> Неопределено Тогда
        Возврат Источник.Товары;
    КонецЕсли;

    Возврат Неопределено;

КонецФункции

Функция СтруктураВJSON(Данные)

    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Журнал обмена пишется в СВОЙ регистр сведений, а не в общий журнал
// регистрации — поддержка просила не засорять ЖР (тысячи записей в день).
// Регистр «GadgetBar_ЖурналОбмена» (структура см. в docs/1c/README.md):
//   Измерение: Идентификатор (УникальныйИдентификатор)
//   Ресурсы:   Дата (Дата), Уровень (Строка 10), Контекст (Строка 100), Текст (Строка неогр.)
Процедура ЗаписатьИнфо(Контекст, Текст)
    ЗаписатьЖурнал("Инфо", Контекст, Текст);
КонецПроцедуры

Процедура ЗаписатьОшибку(Контекст, ТекстОшибки)
    ЗаписатьЖурнал("Ошибка", Контекст, ТекстОшибки);
КонецПроцедуры

Процедура ЗаписатьЖурнал(Уровень, Контекст, Текст)
    Попытка
        Запись = РегистрыСведений.GadgetBar_ЖурналОбмена.СоздатьМенеджерЗаписи();
        Запись.Идентификатор = Новый УникальныйИдентификатор;
        Запись.Дата          = ТекущаяДата();
        Запись.Уровень       = Уровень;
        Запись.Контекст      = Контекст;
        Запись.Текст         = Текст;
        Запись.Записать();
    Исключение
        // Журнал не должен ронять обмен (например, регистр ещё не создан в базе).
    КонецПопытки;
КонецПроцедуры

// Удаляет записи журнала обмена старше 7 дней (пачкой до 500 за вызов).
// Вызывается автоматически из ОбработатьОчередь раз в сутки; можно вручную:
//   ЕдинаяБазаGB.ОчиститьЖурнал();
Процедура ОчиститьЖурнал() Экспорт

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 500
        |   Журнал.Идентификатор КАК Идентификатор
        |ИЗ
        |   РегистрСведений.GadgetBar_ЖурналОбмена КАК Журнал
        |ГДЕ
        |   Журнал.Дата < &Граница";

    Граница = ТекущаяДата() - 7 * 24 * 3600;
    Запрос.УстановитьПараметр("Граница", Граница);

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Запись = РегистрыСведений.GadgetBar_ЖурналОбмена.СоздатьМенеджерЗаписи();
        Запись.Идентификатор = Выборка.Идентификатор;
        Запись.Удалить();
    КонецЦикла;

КонецПроцедуры

// Выключатель отладочных сообщений пользователю.
// В бою — Ложь (продавцы не видят сервисных сообщений).
// Для отладки вернуть Истина — сообщения снова появятся в окне сообщений.
Функция ОтладкаВключена()
    Возврат Ложь;
КонецФункции

// Трассировка обмена. В бою молчит для пользователей,
// при включённой отладке выводит сообщение. Журнал регистрации
// (ЗаписатьИнфо/ЗаписатьОшибку) пишется независимо от этого флага.
Процедура Лог(Текст)
    Если ОтладкаВключена() Тогда
        Сообщить("GadgetBar: " + Текст);
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

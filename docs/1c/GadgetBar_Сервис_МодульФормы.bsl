&НаКлиенте
Процедура ВыполнитьСервис(Команда)
    ПоказатьПредупреждение(, ВыполнитьСервисНаСервере());
КонецПроцедуры

&НаСервере
Функция ВыполнитьСервисНаСервере()
    Текст = "старт" + Символы.ПС;
    Попытка
        ЕдинаяБазаGB.ВыгрузитьВсеСклады();
        Текст = Текст + "склады: ок" + Символы.ПС;
    Исключение
        Текст = Текст + "ОШИБКА складов: " + ОписаниеОшибки() + Символы.ПС;
    КонецПопытки;
    Попытка
        ЕдинаяБазаGB.ОчиститьОчередь();
        Текст = Текст + "очередь: ок" + Символы.ПС;
    Исключение
        Текст = Текст + "ОШИБКА очереди: " + ОписаниеОшибки() + Символы.ПС;
    КонецПопытки;
    Попытка
        ЕдинаяБазаGB.ОбработатьОчередь();
        Текст = Текст + "добивка: ок";
    Исключение
        Текст = Текст + "ОШИБКА добивки: " + ОписаниеОшибки();
    КонецПопытки;
    Возврат Текст;
КонецФункции

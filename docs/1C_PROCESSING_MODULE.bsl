// Модуль обмена с сайтом gbsale.ru для 1С:УНФ 3.0
// Вставьте код в общий модуль или модуль внешней обработки.

#Область Настройки

// Адрес сайта без https:// и без слэша в конце.
Функция АдресСайта() Экспорт
    Возврат "gbsale.ru";
КонецФункции

// Ключ API для заголовка X-1C-API-Key. Должен совпадать с IMPORT_1C_API_KEY на сервере.
// Рекомендуется хранить в константе/регистре сведений, а не в коде модуля.
Функция КлючAPI() Экспорт
    Возврат "<ВСТАВЬТЕ-ПРОДОВЫЙ-КЛЮЧ>"; // не используйте test-1c-key в проде
КонецФункции

// Таймаут HTTP-соединения в секундах.
Функция ТаймаутСоединения() Экспорт
    Возврат 20;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедуры

Функция НовоеHTTPСоединение()
    ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
    Возврат Новый HTTPСоединение(
        АдресСайта(),
        443,
        , , ,
        ТаймаутСоединения(),
        ЗащищенноеСоединение,
        Ложь
    );
КонецФункции

Функция ВыполнитьHTTPЗапрос(Метод, Путь, Тело = Неопределено, ТипКонтента = "application/json")
    Соединение = НовоеHTTPСоединение();
    Запрос = Новый HTTPЗапрос(Путь);
    Запрос.Заголовки.Вставить("X-1C-API-Key", КлючAPI());
    Запрос.Заголовки.Вставить("Content-Type", ТипКонтента);

    Если Тело <> Неопределено Тогда
        Запрос.УстановитьТелоИзСтроки(
            ЗаписатьJSON(Тело),
            КодировкаТекста.UTF8,
            ИспользованиеByteOrderMark.НеИспользовать
        );
    КонецЕсли;

    Если ВРег(Метод) = "POST" Тогда
        Возврат Соединение.ОтправитьДляОбработки(Запрос);
    ИначеЕсли ВРег(Метод) = "PUT" Тогда
        Возврат Соединение.Записать(Запрос);
    ИначеЕсли ВРег(Метод) = "GET" Тогда
        Возврат Соединение.Получить(Запрос);
    Иначе
        ВызватьИсключение "Неизвестный HTTP-метод: " + Метод;
    КонецЕсли;
КонецФункции

Процедура ЗаписатьОшибкуВЖурнал(Сообщение)
    ЗаписьЖурналаРегистрации(
        "GadgetBar.ОбменССайтом",
        УровеньЖурналаРегистрации.Ошибка,
        ,,
        Сообщение
    );
КонецПроцедуры

// Отправляет данные в очередь повторной обработки на сайте (/api/1c/queue).
// Крон на сайте раз в минуту обрабатывает очередь командой 1c:process-queue.
Процедура ОтправитьВОчередь(Путь, Данные)
    Попытка
        Тело = Новый Структура;
        Тело.Вставить("payload", Данные);
        Тело.Вставить("endpoint", Путь);

        Ответ = ВыполнитьHTTPЗапрос("POST", "/api/1c/queue", Тело);

        Если Ответ.КодСостояния <> 200 Тогда
            ЗаписатьОшибкуВЖурнал("Не удалось положить в очередь: " + Ответ.ПолучитьТелоКакСтроку());
        КонецЕсли;
    Исключение
        ЗаписатьОшибкуВЖурнал("Ошибка отправки в очередь: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// Универсальная отправка с fallback в очередь при ошибке.
Процедура ОтправитьСFallbackВОчередь(Путь, Данные)
    Попытка
        Ответ = ВыполнитьHTTPЗапрос("POST", Путь, Данные);

        Если Ответ.КодСостояния >= 500 Тогда
            // Серверная ошибка — повторим позже через очередь.
            ОтправитьВОчередь(Путь, Данные);
        ИначеЕсли Ответ.КодСостояния >= 400 Тогда
            // Клиентская ошибка — логируем, но не повторяем (некорректные данные).
            ЗаписатьОшибкуВЖурнал("Ошибка " + Путь + ": " + Ответ.ПолучитьТелоКакСтроку());
        КонецЕсли;
    Исключение
        // Сеть недоступна — кладём в очередь.
        ОтправитьВОчередь(Путь, Данные);
    КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ОтправкаОбъектов

// Отправка одного товара.
//
// Параметры:
//   Номенклатура - СправочникСсылка.Номенклатура
//   ДополнительныеПараметры - Структура с ключами:
//      * Цена          - Число
//      * Валюта        - Строка, например "RUB"
//      * Количество    - Число
//      * СкладИд       - Строка (external_id склада)
//      * КатегорияИд   - Строка (external_id категории)
//      * Описание      - Строка
//      * Атрибуты      - Массив структур {name, value}
//
Процедура ОтправитьТовар(Номенклатура, ДополнительныеПараметры = Неопределено) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("external_id", Строка(Номенклатура.УникальныйИдентификатор()));
    Данные.Вставить("name", Номенклатура.Наименование);
    Данные.Вставить("sku", Номенклатура.Артикул);

    Если ДополнительныеПараметры <> Неопределено Тогда
        Если ДополнительныеПараметры.Свойство("КатегорияИд") Тогда
            Данные.Вставить("category_external_id", ДополнительныеПараметры.КатегорияИд);
        КонецЕсли;
        Если ДополнительныеПараметры.Свойство("Цена") Тогда
            Данные.Вставить("price", ДополнительныеПараметры.Цена);
            Данные.Вставить("currency", ДополнительныеПараметры.Валюта);
        КонецЕсли;
        Если ДополнительныеПараметры.Свойство("Количество") Тогда
            Данные.Вставить("quantity", ДополнительныеПараметры.Количество);
            Данные.Вставить("store_external_id", ДополнительныеПараметры.СкладИд);
        КонецЕсли;
        Если ДополнительныеПараметры.Свойство("Описание") Тогда
            Данные.Вставить("description", ДополнительныеПараметры.Описание);
        КонецЕсли;
        Если ДополнительныеПараметры.Свойство("Атрибуты") Тогда
            Данные.Вставить("attributes", ДополнительныеПараметры.Атрибуты);
        КонецЕсли;
    КонецЕсли;

    ОтправитьСFallbackВОчередь("/api/1c/products", Данные);
КонецПроцедуры

// Отправка цены для предложения.
//
// Параметры:
//   ИдентификаторПредложения - Строка (UUID оффера)
//   Цена                     - Число
//   Валюта                   - Строка, по умолчанию "RUB"
//   ТипЦены                  - Строка, по умолчанию "retail"
//
Процедура ОтправитьЦену(ИдентификаторПредложения, Цена, Валюта = "RUB", ТипЦены = "retail") Экспорт
    Данные = Новый Структура;
    Данные.Вставить("offer_external_id", ИдентификаторПредложения);
    Данные.Вставить("price", Цена);
    Данные.Вставить("currency", Валюта);
    Данные.Вставить("price_type", ТипЦены);

    ОтправитьСFallbackВОчередь("/api/1c/prices", Данные);
КонецПроцедуры

// Отправка остатка для предложения.
//
// Параметры:
//   ИдентификаторПредложения - Строка (UUID оффера)
//   ИдентификаторСклада      - Строка (external_id склада)
//   Количество               - Число
//
Процедура ОтправитьОстаток(ИдентификаторПредложения, ИдентификаторСклада, Количество) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("offer_external_id", ИдентификаторПредложения);
    Данные.Вставить("store_external_id", ИдентификаторСклада);
    Данные.Вставить("quantity", Количество);

    ОтправитьСFallbackВОчередь("/api/1c/stocks", Данные);
КонецПроцедуры

// Отправка категории.
//
// Параметры:
//   ИдентификаторКатегории        - Строка
//   Наименование                  - Строка
//   ИдентификаторРодителя         - Строка (может быть неопределено)
//
Процедура ОтправитьКатегорию(ИдентификаторКатегории, Наименование, ИдентификаторРодителя = Неопределено) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("external_id", ИдентификаторКатегории);
    Данные.Вставить("name", Наименование);
    Данные.Вставить("is_active", Истина);

    Если ИдентификаторРодителя <> Неопределено Тогда
        Данные.Вставить("parent_external_id", ИдентификаторРодителя);
    КонецЕсли;

    ОтправитьСFallbackВОчередь("/api/1c/categories", Данные);
КонецПроцедуры

// Снятие товара с продажи.
//
// Параметры:
//   ИдентификаторТовара - Строка (UUID номенклатуры)
//
Процедура УдалитьТовар(ИдентификаторТовара, ПостоянноеУдаление = Ложь) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("external_id", ИдентификаторТовара);
    Данные.Вставить("permanent", ПостоянноеУдаление);

    ОтправитьСFallbackВОчередь("/api/1c/products/delete", Данные);
КонецПроцедуры

#КонецОбласти

#Область BulkВыгрузка

// Массовая выгрузка данных на сайт.
// Используется для первоначального наполнения или обновления большого объёма данных в простое.
//
// Параметры:
//   Товары     - Массив структур (формат как у ОтправитьТовар, но без Цена/Количество)
//   Категории  - Массив структур (формат как у ОтправитьКатегорию)
//   Склады     - Массив структур {external_id, name, city, address}
//   Цены       - Массив структур {offer_external_id, price, currency, price_type}
//   Остатки    - Массив структур {offer_external_id, store_external_id, quantity}
//
// Возвращает:
//   Строка - batch_id для проверки статуса через GET /api/1c/bulk-sync/{batch_id}/status
//
Функция ВыполнитьBulkВыгрузку(Товары, Категории = Неопределено, Склады = Неопределено, Цены = Неопределено, Остатки = Неопределено) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("products", Товары);

    Если Категории <> Неопределено Тогда
        Данные.Вставить("categories", Категории);
    КонецЕсли;
    Если Склады <> Неопределено Тогда
        Данные.Вставить("stores", Склады);
    КонецЕсли;
    Если Цены <> Неопределено Тогда
        // Цены и остатки передаём внутри offers для совместимости с bulk-sync
        Данные.Вставить("products", ТоварыСЦенамиИОстатками(Товары, Цены, Остатки));
    ИначеЕсли Остатки <> Неопределено Тогда
        Данные.Вставить("products", ТоварыСЦенамиИОстатками(Товары, Неопределено, Остатки));
    КонецЕсли;

    Ответ = ВыполнитьHTTPЗапрос("POST", "/api/1c/bulk-sync", Данные);

    Если Ответ.КодСостояния <> 200 И Ответ.КодСостояния <> 202 Тогда
        ВызватьИсключение "Bulk-выгрузка не удалась: " + Ответ.ПолучитьТелоКакСтроку();
    КонецЕсли;

    ЧтениеJSON = Новый ЧтениеJSON();
    ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
    Результат = ПрочитатьJSON(ЧтениеJSON);

    Возврат Результат["batch_id"];
КонецФункции

Функция ТоварыСЦенамиИОстатками(Товары, Цены, Остатки)
    СоответствиеЦен = Новый Соответствие;
    Если Цены <> Неопределено Тогда
        Для Каждого Цена Из Цены Цикл
            Список = СоответствиеЦен[Цена.offer_external_id];
            Если Список = Неопределено Тогда
                Список = Новый Массив;
                СоответствиеЦен.Вставить(Цена.offer_external_id, Список);
            КонецЕсли;
            Список.Добавить(Цена);
        КонецЦикла;
    КонецЕсли;

    СоответствиеОстатков = Новый Соответствие;
    Если Остатки <> Неопределено Тогда
        Для Каждого Остаток Из Остатки Цикл
            Список = СоответствиеОстатков[Остаток.offer_external_id];
            Если Список = Неопределено Тогда
                Список = Новый Массив;
                СоответствиеОстатков.Вставить(Остаток.offer_external_id, Список);
            КонецЕсли;
            Список.Добавить(Остаток);
        КонецЦикла;
    КонецЕсли;

    Результат = Новый Массив;
    Для Каждого Товар Из Товары Цикл
        Копия = Новый Структура;
        Для Каждого КлючЗначение Из Товар Цикл
            Копия.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
        КонецЦикла;

        Если Не Копия.Свойство("offers") Тогда
            Копия.Вставить("offers", Новый Массив);
        КонецЕсли;

        // Если у товара нет offers, создаём дефолтный из самого товара
        Если Копия.offers.Количество() = 0 Тогда
            Оффер = Новый Структура;
            Оффер.Вставить("external_id", Копия.external_id);
            Оффер.Вставить("name", Копия.name);
            Оффер.Вставить("sku", ?(Копия.Свойство("sku"), Копия.sku, ""));
            Оффер.Вставить("prices", СоответствиеЦен[Копия.external_id]);
            Оффер.Вставить("stocks", СоответствиеОстатков[Копия.external_id]);
            Копия.offers.Добавить(Оффер);
        Иначе
            Для Каждого Оффер Из Копия.offers Цикл
                Если СоответствиеЦен[Оффер.external_id] <> Неопределено Тогда
                    Оффер.Вставить("prices", СоответствиеЦен[Оффер.external_id]);
                КонецЕсли;
                Если СоответствиеОстатков[Оффер.external_id] <> Неопределено Тогда
                    Оффер.Вставить("stocks", СоответствиеОстатков[Оффер.external_id]);
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;

        Результат.Добавить(Копия);
    КонецЦикла;

    Возврат Результат;
КонецФункции

#КонецОбласти
